# Conexão PostgreSQL do Neon (mantenha credenciais somente no .env, nunca faça commit dele)
DATABASE_URL=jdbc:postgresql://HOST_NEON:5432/NOME_BANCO?user=USUARIO&password=SENHA_CODIFICADA&sslmode=require&channelBinding=require

JWT_SECRET=COLOQUE_AQUI_UMA_CHAVE_ALEATORIA_DE_32_BYTES_OU_MAIS
JWT_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# Upstash Redis REST (copie os valores da aba REST no painel do Upstash)
UPSTASH_REDIS_REST_URL=https://ENDPOINT_REST_UPSTASH
UPSTASH_REDIS_REST_TOKEN=TOKEN_REST_UPSTASH

# E-mail SMTP (exemplo padrão: STARTTLS na porta 587; preencha conforme seu provedor)
MAIL_HOST=SMTP_HOST_DO_PROVEDOR
MAIL_PORT=587
MAIL_USERNAME=USUARIO_SMTP
MAIL_PASSWORD=SENHA_OU_SENHA_DE_APP
MAIL_FROM=EMAIL_VERIFICADO_NO_PROVEDOR
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# Databricks AI/BI dashboard embed (use o host HTTPS do workspace, sem / no final)
DATABRICKS_INSTANCE_URL=https://HOST_DO_WORKSPACE_DATABRICKS
DATABRICKS_WORKSPACE_ID=ID_DO_WORKSPACE
DATABRICKS_DASHBOARD_ID=ID_DO_DASHBOARD_PUBLICADO
DATABRICKS_CLIENT_ID=ID_DO_SERVICE_PRINCIPAL
DATABRICKS_CLIENT_SECRET=SEGREDO_OAUTH_DO_SERVICE_PRINCIPAL

# Origem do front autorizada a chamar a API; inclua a origem de produção no ambiente publicado
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
